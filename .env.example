# Copy to .env and fill in. Never commit .env.

# Required in production: a long random string.
SKILLOS_JWT_SECRET=change-me-to-a-long-random-string
SKILLOS_ENV=development

# AI provider for video extraction, camera observation and the AI assistant: openai or hf.
# Without the matching settings below, those features report "not configured" instead of returning fake results.
SKILLOS_AI_PROVIDER=openai

# Hugging Face (when SKILLOS_AI_PROVIDER=hf). Uses Inference Providers via https://router.huggingface.co/v1.
# HF_TOKEN needs the "Make calls to Inference Providers" permission.
HF_TOKEN=
# A vision-capable chat model, e.g. Qwen/Qwen2.5-VL-72B-Instruct. Append :provider to pin one (e.g. :nebius).
SKILLOS_HF_MODEL=

# Local transcription with faster-whisper (pip install faster-whisper), e.g. small or medium.
# Takes precedence over OPENAI_TRANSCRIPTION_MODEL. Optional; extraction runs without a transcript if unset.
SKILLOS_WHISPER_MODEL=

# OpenAI (when SKILLOS_AI_PROVIDER=openai).
OPENAI_API_KEY=
# A vision-capable model that supports structured outputs on the Responses API.
OPENAI_MODEL=
# A transcription model (e.g. whisper-1). Optional; extraction runs without a transcript if unset.
OPENAI_TRANSCRIPTION_MODEL=

# Optional: path to YOLO weights trained on solar components (requires `pip install ultralytics`).
SKILLOS_YOLO_WEIGHTS=

# Load the demo organization, users and the three solar modules on startup.
SKILLOS_SEED_DEMO_DATA=true
